-        Ok(Q4 { q, sm, n: shape[1], k: shape[2] * 2 })
+    fn q4(&mut self, name: &str, host: bool) -> Result<Q4> {
+        if !host {
+            let (q, shape) = self.raw(&format!("{name}.q4"), Dtype::U8)?;
+            let (sm, _) = self.raw(&format!("{name}.sm"), Dtype::F16)?;
+            return Ok(Q4 { q: ExpertBuf::Device(q), sm: ExpertBuf::Device(sm), n: shape[1], k: shape[2] * 2 });
+        }
+        // Pinned host memory: the kernels read it directly over PCIe (unified addressing).
+        let tq = self.st.tensor(&format!("{name}.q4")).map_err(|e| anyhow!("{}{name}.q4: {e}", self.prefix))?;
+        let ts = self.st.tensor(&format!("{name}.sm")).map_err(|e| anyhow!("{}{name}.sm: {e}", self.prefix))?;
+        if tq.dtype() != Dtype::U8 || ts.dtype() != Dtype::F16 {
+            bail!("{}{name}: unexpected dtypes", self.prefix);
+        }
+        let shape = tq.shape().to_vec();
+        let q = Pinned::<u8>::new(tq.data().len())?;
+        let sm = Pinned::<u16>::new(ts.data().len() / 2)?;
+        unsafe {
+            std::ptr::copy_nonoverlapping(tq.data().as_ptr(), q.ptr(), tq.data().len());
+            std::ptr::copy_nonoverlapping(ts.data().as_ptr(), sm.ptr() as *mut u8, ts.data().len());
+        }
+        Ok(Q4 { q: ExpertBuf::Host(q), sm: ExpertBuf::Host(sm), n: shape[1], k: shape[2] * 2 })
     }
 }
 
